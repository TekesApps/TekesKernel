(version 1)
(deny default)
(import "system.sb")
(allow file-read-metadata (literal "/"))
(allow file-read-metadata (literal "/private"))
(allow file-read-metadata (literal "/private/tmp"))
(allow file-read-metadata (literal "/private/tmp/tekes"))
(allow file-read-metadata (literal "/Applications"))
(allow file-read-metadata (literal "/Library"))
(allow file-read* (subpath "/System"))
(allow file-read* (subpath "/usr"))
(allow file-read* (subpath "/bin"))
(allow file-read* (subpath "/sbin"))
(allow file-read* (subpath "/private/var/select"))
(allow file-read* (subpath "/Applications/Xcode.app"))
(allow file-read* (subpath "/Library/Developer/CommandLineTools"))
(allow file-read* (subpath "/private/tmp/tekes"))
(allow file-write* (subpath "/private/tmp/tekes/work"))
(allow file-read* file-write* (subpath "/private/tmp/tekes/scratch"))
(allow process-exec process-fork)
