{"tools":[{"description":"Read DXF entities by handle (group code 5): type, layer, bbox, geometry, style, XDATA and raw tags.\n\nUnknown handles are reported in `missing_handles` instead of failing the call.\n","inputSchema":{"properties":{"handles":{"items":{"type":"string"},"title":"Handles","type":"array"},"include_raw":{"default":true,"title":"Include Raw","type":"boolean"},"layout":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Layout"},"path":{"title":"Path","type":"string"}},"required":["path","handles"],"title":"get_entitiesArguments","type":"object"},"name":"get_entities","outputSchema":{"additionalProperties":true,"title":"get_entitiesDictOutput","type":"object"}},{"description":"Translate entities by dx/dy in the XY plane, writing the same file atomically in place.","inputSchema":{"properties":{"dx":{"title":"Dx","type":"number"},"dy":{"title":"Dy","type":"number"},"handles":{"items":{"type":"string"},"title":"Handles","type":"array"},"layout":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Layout"},"path":{"title":"Path","type":"string"}},"required":["path","handles","dx","dy"],"title":"moveArguments","type":"object"},"name":"move","outputSchema":{"additionalProperties":true,"title":"moveDictOutput","type":"object"}},{"description":"Delete entities in place; warns about DIMENSION and block references and reports dangling handle references.","inputSchema":{"properties":{"handles":{"items":{"type":"string"},"title":"Handles","type":"array"},"layout":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Layout"},"path":{"title":"Path","type":"string"}},"required":["path","handles"],"title":"deleteArguments","type":"object"},"name":"delete","outputSchema":{"additionalProperties":true,"title":"deleteDictOutput","type":"object"}},{"description":"Replace the content of one TEXT or MTEXT entity, keeping its placement, style and XDATA.","inputSchema":{"properties":{"handle":{"title":"Handle","type":"string