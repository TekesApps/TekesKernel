{
  "request": {
    "type": "client-request",
    "rpcId": "rpc-history-1",
    "method": "session.history",
    "payload": { "sessionId": "session-1", "maxMessages": 50 }
  },
  "success": {
    "type": "server-response",
    "rpcId": "rpc-history-1",
    "result": { "ok": true, "value": { "items": [] } }
  },
  "failure": {
    "type": "server-response",
    "rpcId": "rpc-history-1",
    "result": {
      "ok": false,
      "error": {
        "code": "session-not-found",
        "message": "Session was not found",
        "details": { "sessionId": "session-1" }
      }
    }
  }
}
